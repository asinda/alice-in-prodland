# --- Admin / sécurité (obligatoires en production) ---
ADMIN_PASSWORD=
JWT_SECRET=                 # chaîne aléatoire longue (openssl rand -base64 48)
PUBLISH_SECRET=             # Bearer token de POST /api/schedule/publish
BACKUP_SECRET=              # >= 16 car. ; active GET /api/backup (export JSON des données)

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DOMAIN=                        # domaine servi par Caddy (docker-compose.yml), ex. alice-in-prodland.duckdns.org
NEXT_PUBLIC_CF_BEACON_TOKEN=   # Cloudflare Web Analytics (optionnel)
NEXT_PUBLIC_LEGAL_NAME=        # éditeur affiché dans les mentions légales
NEXT_PUBLIC_CONTACT_EMAIL=     # contact affiché (mentions légales + confidentialité)
NEXT_PUBLIC_HOST_ADDRESS=      # adresse postale de l hébergeur (exigée par la LCEN)
MAINTENANCE_MODE=              # "true" pour afficher la page en construction
PREVIEW_SECRET=                # ?preview=<secret> contourne la maintenance

# --- Contenu ---
OBSIDIAN_VAULT_PATH=           # chemin absolu du vault local (optionnel)
ANTHROPIC_API_KEY=             # agents d'amélioration / traduction / social
# ANTHROPIC_MODEL_FAST= ANTHROPIC_MODEL_QUALITY= ANTHROPIC_MODEL_REVIEW=   (surcharges optionnelles des modèles)

# --- Intégrations sociales (optionnelles) ---
SOCIAL_AUTO_POST=              # "true" = publier sans validation humaine (déconseillé) ; sinon brouillons dans /admin/social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
